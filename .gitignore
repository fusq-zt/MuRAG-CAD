# ============================
# === Python 缓存垃圾文件 ===
# ============================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# ============================
# === 操作系统临时文件 ===
# ============================
.DS_Store
Thumbs.db

# ============================
# === 大文件：模型权重 ===
# ============================
*.pth
*.pt
*.h5
*.ckpt

# ============================
# === 敏感信息（不要上传）===
# ============================
.env
*.env
api_key.txt
secret.py
config_secret.yaml

# ============================
# === IDE & 编辑器缓存 ===
# ============================
.vscode/
.idea/
*.iml

# ============================
# === 训练输出结果目录 ===
# 这些都是运行后生成的文件，无需上传
# ============================
MuRAG-CAD/classification/single_results/
MuRAG-CAD/segmentation/signal_results/
MuRAG-CAD/classification/logs/
MuRAG-CAD/segmentation/logs/
MuRAG-CAD/classification/workings/

# ============================
# === 只上传数据集文件夹结构，不上传具体文件 ===
# ============================
MuRAG-CAD/Dataset_BUSI_with_GT/*
!MuRAG-CAD/
